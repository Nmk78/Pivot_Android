{
  "expo": {
    "name": "Pivot",
    "slug": "pivot",
    "scheme": "lite.pivot.com",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "version": "0.0.1",
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "src/assets/**/*"
    ],
    "plugins": [
      [
        "expo-router",
        {
          "origin": "http://localhost:8081"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "kotlinVersion": "1.6.21"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photos to let you share them.",
          "cameraPermission": "This app needs access to your camera to take photos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "This app needs access to your microphone to record voice messages."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./src/assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.expoaichatbot.lite",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.expoaichatbot.lite",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record voice messages.",
        "NSDocumentsFolderUsageDescription": "This app needs access to your documents to upload files for analysis."
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "naymyokhant",
    "extra": {
      "eas": {
        "projectId": "eb6a0abc-050a-4ab1-bd46-317beca9e1f9"
      },
      "router": {
        "origin": "http://localhost:8081"
      }
    },
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "url": "https://u.expo.dev/eb6a0abc-050a-4ab1-bd46-317beca9e1f9"
    }
  }
}
